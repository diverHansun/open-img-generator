{
  "name": "ai-image-generator",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": ".desktop-build/main.cjs",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || ^24.0.0"
  },
  "description": "Open-source multi-provider AI image generator (backend-first, web-then-app).",
  "scripts": {
    "predev": "npm run db:migrate",
    "dev": "next dev",
    "build": "next build",
    "desktop:compile": "node scripts/build-electron.mjs",
    "desktop:dev": "npm run desktop:compile && electron .",
    "desktop:smoke": "node scripts/smoke-desktop-runtime.mjs",
    "desktop:package:mac": "node scripts/package-desktop.mjs arm64 x64",
    "desktop:package:mac:arm64": "node scripts/package-desktop.mjs arm64",
    "desktop:package:mac:x64": "node scripts/package-desktop.mjs x64",
    "prestart": "npm run db:migrate",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:push": "drizzle-kit push",
    "recover:missing-media": "vite-node scripts/recover-missing-media.ts",
    "test": "vitest run",
    "test:unit": "vitest run .unit.test.ts",
    "test:contract": "vitest run .contract.test.ts",
    "test:integration": "vitest run .integration.test.ts",
    "test:smoke": "vitest run .smoke.test.ts",
    "version:check": "node scripts/check-version.mjs",
    "test:fast": "npm run test:unit && npm run test:contract",
    "preflight": "npm run typecheck && npm run test:fast",
    "test:verify": "npm run typecheck && npm run test:fast && npm run test:integration",
    "test:release": "npm run version:check && npm run test:verify && npm run test:smoke",
    "release:check": "npm run test:release"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/suse": "5.3.0",
    "@fontsource/lxgw-wenkai": "5.3.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.0",
    "lucide-react": "^1.25.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yazl": "^3.3.1",
    "client-only": "0.0.1",
    "drizzle-kit": "^0.28.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "msw": "^2.6.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
