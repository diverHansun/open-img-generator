# Keep this repo on Node 20/22/24 (see package.json engines). Homebrew's
# default `node` formula may be Current (e.g. 26) and will break better-sqlite3.
if [ -x /opt/homebrew/opt/node@24/bin/node ]; then
  PATH_add /opt/homebrew/opt/node@24/bin
elif [ -x /usr/local/opt/node@24/bin/node ]; then
  PATH_add /usr/local/opt/node@24/bin
fi
