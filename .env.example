# ===== Provider API Keys =====
# 启用规则:哪个 key 存在,对应 provider 就启用;缺 key 静默不启用,不报错。

# fal.ai (异步队列,首跑优先)
FAL_KEY=
# Optional trusted Fal queue origin. Dynamic status/response/cancel URLs must
# exactly match this origin; http:// is useful only for local test providers.
FAL_BASE_URL=https://queue.fal.run

# ZenMux (首跑用 OpenAI 兼容模式;Gemini 模式待 Node 端验证)
ZENMUX_API_KEY=

# SiliconFlow
SILICONFLOW_API_KEY=

# Zhipu (智谱)
ZHIPU_API_KEY=
# Single-user compliance identifier sent to image generation requests.
ZHIPU_USER_ID=local-user

# Doubao (字节豆包,火山引擎 Ark)
ARK_API_KEY=
# 可选：切换 Ark 区域/网关，默认北京官方 API。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Qwen (阿里通义,百炼 DashScope)
DASHSCOPE_API_KEY=
# 默认北京区域；后续 Qwen adapter 读取此服务端地址。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Optional single-user local access control. When set, API requests require
# Bearer token or the HttpOnly cookie created by POST /api/auth/session.
APP_AUTH_TOKEN=

# Encrypted user credential store (server-only; generate a random secret).
USER_CONFIG_ENCRYPTION_KEY=
USER_CONFIG_DIR=

# Background polling/cleanup worker (same Node process; bootstrapped by health/generation API handlers).
JOB_WORKER_ENABLED=true
WORKER_INTERVAL_MS=5000
WORKER_BATCH_SIZE=16
# Synchronous image APIs wait for a completed image in their submit response.
# Valid values are positive integer milliseconds up to 180000; invalid values
# fall back to the safe three-minute default. Async queue submit/poll budgets
# remain unchanged.
SYNC_IMAGE_GENERATION_TIMEOUT_MS=180000
# Unfavorited images never expire by default. Set a positive number of days to
# enable automatic expiry; 0 also disables it. The Web Settings page persists
# a user choice in settings.json and takes precedence when it has been saved.
IMAGE_RETENTION_DAYS=0
IMAGE_ORPHAN_GRACE_MS=3600000
IMAGE_CLEANUP_INTERVAL_MS=3600000

# ===== 存储 =====
# v1: local (本地 FS);v2: r2 / s3
STORAGE_PROVIDER=local
# 本地存储根目录(相对项目根)
LOCAL_STORAGE_DIR=./data/images
# Safe structured audit log. The current app.jsonl is capped at 5 MiB and
# keeps three rotations. Set APP_FILE_LOG_ENABLED=0 to retain stderr only.
APP_LOG_DIR=./data/logs
APP_FILE_LOG_ENABLED=1
# Remote output images are HTTPS-only and reject loopback/private addresses by
# default. These two switches are solely for a local fake-provider/dev setup;
# never enable either in a public deployment.
# ALLOW_INSECURE_IMAGE_URLS=false
# ALLOW_PRIVATE_IMAGE_URLS=false
# A comma-separated, exact hostname allowlist for a local transparent proxy
# that maps an external HTTPS media CDN into 198.18.0.0/15. Leave empty unless
# this mapping is verified (for example: v3b.fal.media). This is deliberately
# not a private-network bypass; redirects are checked against it again.
TRUSTED_PROXY_IMAGE_HOSTS=

# ===== 数据库 =====
DATABASE_URL=file:./data/app.db
