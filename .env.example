# ===== Provider API Keys =====
# 启用规则:哪个 key 存在,对应 provider 就启用;缺 key 静默不启用,不报错。

# fal.ai (异步队列,首跑优先)
FAL_KEY=

# ZenMux (首跑用 OpenAI 兼容模式;Gemini 模式待 Node 端验证)
ZENMUX_API_KEY=

# SiliconFlow
SILICONFLOW_API_KEY=

# Zhipu (智谱)
ZHIPU_API_KEY=
# Single-user compliance identifier sent to image generation requests.
ZHIPU_USER_ID=local-user

# Doubao (字节豆包,火山引擎 Ark)
ARK_API_KEY=
# 可选：切换 Ark 区域/网关，默认北京官方 API。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Qwen (阿里通义,百炼 DashScope)
DASHSCOPE_API_KEY=
# 默认北京区域；后续 Qwen adapter 读取此服务端地址。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Kling (可灵；独立 Kling API，不复用 DashScope)
KLING_API_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com

# Optional single-user local access control. When set, API requests require
# Bearer token or the HttpOnly cookie created by POST /api/auth/session.
APP_AUTH_TOKEN=

# Encrypted user credential store (server-only; generate a random secret).
USER_CONFIG_ENCRYPTION_KEY=
USER_CONFIG_DIR=

# Background polling/cleanup worker (same Node process; bootstrapped by health/generation API handlers).
JOB_WORKER_ENABLED=false
WORKER_INTERVAL_MS=5000
WORKER_BATCH_SIZE=16
MAX_INFLIGHT_GENERATIONS=4
MAX_INFLIGHT_PER_PROVIDER=2
# Per-process waiting queue for Provider calls. A full/expired queue never
# starts HTTP and is safely retried by the durable job engine.
MAX_QUEUED_PER_PROVIDER=32
PROVIDER_QUEUE_TIMEOUT_MS=30000
IMAGE_RETENTION_DAYS=30
IMAGE_ORPHAN_GRACE_MS=3600000
IMAGE_CLEANUP_INTERVAL_MS=3600000

# ===== 存储 =====
# v1: local (本地 FS);v2: r2 / s3
STORAGE_PROVIDER=local
# 本地存储根目录(相对项目根)
LOCAL_STORAGE_DIR=./data/images

# ===== 数据库 =====
DATABASE_URL=file:./data/app.db
